# All variables are optional for the first release. With none set, KOTOBA runs in
# local mode: learner data is stored in this browser only.

# --- Browser-safe (public) -------------------------------------------------
# Supabase project URL and anon key. Safe to expose: data is protected by RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-side ONLY (Supabase Edge Function secrets; never prefix with VITE_) ---
# Set with: supabase secrets set AI_PROVIDER=... AI_API_KEY=...
# Used by AI Sensei (Milestone 6). Not read anywhere in frontend code.
# AI_PROVIDER=
# AI_API_KEY=
# AI_MODEL=
